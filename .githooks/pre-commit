#!/bin/sh
# 词表校验不通过就不许提交。
# 起因：我把 commit 串在校验命令后面，校验失败也照样提交，
# 结果 4 个重复词被推上线。判断不该由我在命令行里临时做。
if git diff --cached --name-only | grep -q '^wordlists/'; then
  echo "→ 词表有改动，运行校验…"
  if ! python3 scripts/check-wordlist.py 'wordlists/A-*.txt' 'wordlists/B-*.txt'; then
    echo
    echo "❌ 校验未通过，提交已中止。修好再提交，或用 --no-verify 强行跳过（不建议）。"
    exit 1
  fi
  # 凑数义项：冷僻词为了凑够义项数，编出跟词条本身无关的例句和讲解。
  # 用户 2026-09-05 明令禁止。check-wordlist 只数数目，看不出来，
  # 所以单独拦一道 —— 真的只有两个义项就写两个。
  if ! python3 scripts/audit-padding.py; then
    echo
    echo "❌ 有凑数义项，提交已中止。例句和等式都要落回词头本身。"
    exit 1
  fi
  # B 是全量表，理应是 A 的超集：A 教过的搭配 B 里必须找得到。
  # 2026-09-05 首跑 132 条缺口，全部补完后归零，从此不许回潮。
  if ! python3 scripts/audit-ab.py; then
    echo
    echo "❌ 有 A 教过而 B 没有的用法，提交已中止。补进 B 的对应词条。"
    exit 1
  fi
fi
